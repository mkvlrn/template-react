{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "mise-devcontainer-archlinux-${localWorkspaceFolderBasename}",
  "image": "ghcr.io/mkvlrn/mise-devcontainer-archlinux:current@sha256:07718363a855fbbfef6128691eb925ed2bde8ab507db0ddf66405198df2512d2",
  "containerUser": "root",
  "remoteUser": "dev",
  "privileged": true,
  "updateRemoteUserUID": true,
  "workspaceFolder": "/code/${localWorkspaceFolderBasename}",
  "workspaceMount": "source=${localWorkspaceFolder},target=/code/${localWorkspaceFolderBasename},type=bind",
  "mounts": ["source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind"],
  "overrideCommand": false,
  "postCreateCommand": ["/bin/zsh", "-lc", "/usr/local/bin/post-create.sh"],
  "postStartCommand": ["/bin/zsh", "-lc", "/usr/local/bin/post-start.sh"],
  "postAttachCommand": ["/bin/zsh", "-lc", "/usr/local/bin/post-start.sh"],
  "waitFor": "postStartCommand",
  "containerEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent",
    "MISE_GITHUB_TOKEN": "${localEnv:MISE_GITHUB_TOKEN}"
  }
}
